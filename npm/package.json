{
  "name": "@keyhalve/verify-mcp",
  "version": "0.1.0",
  "description": "Verify KeyHalve-sealed documents from any MCP client — stdio bridge to the free, public, no-account KeyHalve verification server (mcp.keyhalve.com). Read-only; never receives decryption keys.",
  "mcpName": "com.keyhalve/verify",
  "keywords": [
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "document-verification",
    "verification",
    "keyhalve"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.mjs"
    }
  },
  "bin": {
    "keyhalve-verify-mcp": "bin/keyhalve-verify-mcp.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.12.0 <2"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keyhalve/keyhalve-mcp.git",
    "directory": "npm"
  },
  "homepage": "https://keyhalve.com/mcp"
}
